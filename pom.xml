<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      POM padre del monorepo backend de redSegura.
      Centraliza la version de Java, el BOM de Spring Boot y la configuracion comun de
      calidad (Spotless, Checkstyle, JaCoCo) que heredan los microservicios Java.
      Los servicios Python (FastAPI) NO forman parte del reactor Maven: se gestionan con su
      propio pyproject.toml/requirements. Ver ../management/documentos/arquitectura.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.redsegura</groupId>
    <artifactId>redsegura-backend-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>redSegura :: backend (parent)</name>
    <description>POM padre del monorepo de microservicios backend de redSegura</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones de plugins de calidad -->
        <spotless.version>2.43.0</spotless.version>
        <checkstyle.plugin.version>3.5.0</checkstyle.plugin.version>
        <checkstyle.version>10.18.2</checkstyle.version>
        <jacoco.version>0.8.12</jacoco.version>

        <!-- Umbral de cobertura minima (gatekeeper: >= 70% statements) -->
        <jacoco.coverage.minimum>0.70</jacoco.coverage.minimum>
    </properties>

    <!--
      Los modulos (microservicios Java) se agregan aqui a medida que se scaffoldean.
      Se deja vacio para que `mvn -N validate` funcione sin modulos inexistentes.
      Servicios Java previstos: asset-inventory-service, alerting-service,
      notification-service (Fase A); vulnerability-service, remediation-tracking-service (Fase B).
    -->
    <modules>
        <!-- <module>asset-inventory-service</module> -->
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Formato: google-java-format via Spotless. Gate: `mvn spotless:check`. -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat/>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>

                <!-- Estilo/lint: Checkstyle (google_checks). Gate: `mvn checkstyle:check`. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle.plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>google_checks.xml</configLocation>
                        <consoleOutput>true</consoleOutput>
                        <failsOnError>true</failsOnError>
                        <violationSeverity>warning</violationSeverity>
                    </configuration>
                </plugin>

                <!-- Cobertura: JaCoCo. Umbral >= 70% (gatekeeper). -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.coverage.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
