{
 "info": {
  "name": "redSegura · config-backup-service (dev)",
  "description": "Colección de pruebas de config-backup-service (RF-06..10) sobre docker-compose.dev.yml.\n\n1) Ejecuta **Auth › Token (Administrador)** (o el rol que quieras) → guarda {{access_token}}.\n2) Lanza los requests. Los códigos esperados están en cada descripción y en los tests.\n\nVer ../documentos/verificacion_endpoints.md y GUIA_PRUEBAS_POSTMAN.md.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{access_token}}",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "base_url",
   "value": "http://localhost:8082"
  },
  {
   "key": "keycloak_url",
   "value": "http://localhost:8080"
  },
  {
   "key": "client_id",
   "value": "redsegura-postman"
  },
  {
   "key": "access_token",
   "value": ""
  },
  {
   "key": "deviceId",
   "value": "11111111-1111-1111-1111-111111111111"
  },
  {
   "key": "jobId",
   "value": ""
  },
  {
   "key": "scheduleId",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Auth",
   "item": [
    {
     "name": "Token (Administrador)",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200 OK', () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/x-www-form-urlencoded"
       }
      ],
      "url": "{{keycloak_url}}/realms/redsegura/protocol/openid-connect/token",
      "body": {
       "mode": "urlencoded",
       "urlencoded": [
        {
         "key": "grant_type",
         "value": "password"
        },
        {
         "key": "client_id",
         "value": "{{client_id}}"
        },
        {
         "key": "username",
         "value": "admin"
        },
        {
         "key": "password",
         "value": "password"
        }
       ]
      },
      "description": "Obtiene un JWT del rol Administrador y lo guarda en {{access_token}}. Ejecuta este request antes de los demás."
     }
    },
    {
     "name": "Token (Operador)",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200 OK', () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/x-www-form-urlencoded"
       }
      ],
      "url": "{{keycloak_url}}/realms/redsegura/protocol/openid-connect/token",
      "body": {
       "mode": "urlencoded",
       "urlencoded": [
        {
         "key": "grant_type",
         "value": "password"
        },
        {
         "key": "client_id",
         "value": "{{client_id}}"
        },
        {
         "key": "username",
         "value": "operador"
        },
        {
         "key": "password",
         "value": "password"
        }
       ]
      },
      "description": "Obtiene un JWT del rol Operador y lo guarda en {{access_token}}. Ejecuta este request antes de los demás."
     }
    },
    {
     "name": "Token (Auditor)",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200 OK', () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/x-www-form-urlencoded"
       }
      ],
      "url": "{{keycloak_url}}/realms/redsegura/protocol/openid-connect/token",
      "body": {
       "mode": "urlencoded",
       "urlencoded": [
        {
         "key": "grant_type",
         "value": "password"
        },
        {
         "key": "client_id",
         "value": "{{client_id}}"
        },
        {
         "key": "username",
         "value": "auditor"
        },
        {
         "key": "password",
         "value": "password"
        }
       ]
      },
      "description": "Obtiene un JWT del rol Auditor y lo guarda en {{access_token}}. Ejecuta este request antes de los demás."
     }
    }
   ]
  },
  {
   "name": "Salud y observabilidad (sin token)",
   "item": [
    {
     "name": "Liveness",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/api/v1/health/liveness",
      "header": [],
      "auth": {
       "type": "noauth"
      },
      "description": "Esperado 200."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    },
    {
     "name": "Readiness",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/api/v1/health/readiness",
      "header": [],
      "auth": {
       "type": "noauth"
      },
      "description": "Esperado 200 (BD/broker/Git)."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    },
    {
     "name": "Metrics (Prometheus)",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/metrics",
      "header": [],
      "auth": {
       "type": "noauth"
      },
      "description": "Esperado 200; expone métricas HTTP + dominio."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "Programaciones (schedules, RF-08)",
   "item": [
    {
     "name": "Crear schedule — ADM (201)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/schedules",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\"type\": \"backup\", \"cron\": \"0 2 * * *\", \"target\": {\"scope\": \"all\"}}"
      },
      "description": "Solo ADM. Esperado 201 Schedule. Requiere token de Administrador."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('201',()=>pm.response.to.have.status(201));",
         "pm.collectionVariables.set('scheduleId', pm.response.json().id);"
        ]
       }
      }
     ]
    },
    {
     "name": "Crear schedule — cron inválido (400)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/schedules",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\"type\": \"backup\", \"cron\": \"malo\", \"target\": {\"scope\": \"all\"}}"
      },
      "description": "Esperado 400 (cron inválido). Token ADM."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('400',()=>pm.response.to.have.status(400));"
        ]
       }
      }
     ]
    },
    {
     "name": "Crear schedule — Operador (403)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/schedules",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\"type\": \"backup\", \"cron\": \"0 2 * * *\", \"target\": {\"scope\": \"all\"}}"
      },
      "description": "Con token de Operador → 403 (solo ADM crea)."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('403',()=>pm.response.to.have.status(403));"
        ]
       }
      }
     ]
    },
    {
     "name": "Listar schedules (200)",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/api/v1/schedules?type=backup&estado=activa",
      "header": [],
      "description": "ADM/OPE/AUD. Esperado 200 página."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "Respaldos (backups, RF-06/07/10)",
   "item": [
    {
     "name": "Respaldo individual — ADM",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/devices/{{deviceId}}/backups",
      "header": [],
      "description": "ADM/OPE. 201 si el dispositivo está en la vista y responde SSH; 404 si no existe; 422 fuera de alcance."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('201/404/422',()=>pm.expect([201,404,422]).to.include(pm.response.code));"
        ]
       }
      }
     ]
    },
    {
     "name": "Respaldo por lotes — scope=all (202)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/backups",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\"scope\": \"all\"}"
      },
      "description": "ADM/OPE. Ejecución asíncrona → 202 + jobId."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('202',()=>pm.response.to.have.status(202));",
         "pm.collectionVariables.set('jobId', pm.response.json().jobId);"
        ]
       }
      }
     ]
    },
    {
     "name": "Respaldo por lotes — target inválido (422)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/backups",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{}"
      },
      "description": "target vacío viola 'exactamente uno' (RN-CB8). Esperado 422."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('422',()=>pm.response.to.have.status(422));"
        ]
       }
      }
     ]
    },
    {
     "name": "Estado del job de respaldo",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/api/v1/backups/jobs/{{jobId}}",
      "header": [],
      "description": "Seguimiento del lote hasta COMPLETED (completed/failed por dispositivo)."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    },
    {
     "name": "Historial de respaldos",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/api/v1/backups?deviceId={{deviceId}}",
      "header": [],
      "description": "ADM/OPE/AUD. Esperado 200 página."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "Drift (RF-09)",
   "item": [
    {
     "name": "Drift-check individual",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/devices/{{deviceId}}/drift-check",
      "header": [],
      "description": "ADM/OPE. 200 con drift:true|false; emite config.drift_detected si difiere."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200/404',()=>pm.expect([200,404]).to.include(pm.response.code));"
        ]
       }
      }
     ]
    },
    {
     "name": "Drift-check por lotes (202)",
     "request": {
      "method": "POST",
      "url": "{{base_url}}/api/v1/drift-checks",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\"scope\": \"all\"}"
      },
      "description": "ADM/OPE. Asíncrono → 202 + jobId."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('202',()=>pm.response.to.have.status(202));"
        ]
       }
      }
     ]
    }
   ]
  }
 ]
}
